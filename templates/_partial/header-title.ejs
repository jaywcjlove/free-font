<%
  const heading = typeof pageHeading !== "undefined" && pageHeading ? pageHeading : "Free Font 商用免费字体下载";
  const headingHref = typeof pageHeadingHref !== "undefined" && pageHeadingHref ? pageHeadingHref : (PUBLIC_PATH + "index.html");
  const useBrandParagraph = typeof brandAs !== "undefined" && brandAs === "p";
%>
<% if (useBrandParagraph) { %>
<p class="site-title"><a href="<%= PUBLIC_PATH %>index.html">Free Font 商用免费字体下载</a></p>
<% } else { %>
<h1><a href="<%= headingHref %>"><%= heading %></a></h1>
<% } %>
<nav aria-label="字体分类">
  <a class="<%= type === "全部" ? "active" : "" %>" href="<%= PUBLIC_PATH %>index.html"<% if (type === "全部") { %> aria-current="page"<% } %>>全部字体</a>
  <a class="<%= type === "黑体" ? "active" : "" %>" href="<%= PUBLIC_PATH %>hei.html"<% if (type === "黑体") { %> aria-current="page"<% } %>>黑体</a>
  <a class="<%= type === "楷体" ? "active" : "" %>" href="<%= PUBLIC_PATH %>kai.html"<% if (type === "楷体") { %> aria-current="page"<% } %>>楷体</a>
  <a class="<%= type === "宋体" ? "active" : "" %>" href="<%= PUBLIC_PATH %>song.html"<% if (type === "宋体") { %> aria-current="page"<% } %>>宋体</a>
  <a class="<%= type === "艺术体" ? "active" : "" %>" href="<%= PUBLIC_PATH %>art.html"<% if (type === "艺术体") { %> aria-current="page"<% } %>>艺术体</a>
  <a class="<%= type === "手绘体" ? "active" : "" %>" href="<%= PUBLIC_PATH %>handwriting.html"<% if (type === "手绘体") { %> aria-current="page"<% } %>>手绘体</a>
  <a class="<%= type === "英文" ? "active" : "" %>" href="<%= PUBLIC_PATH %>english.html"<% if (type === "英文") { %> aria-current="page"<% } %>>英文字体</a>
  <a class="<%= type === "开源字体" ? "active" : "" %>" href="<%= PUBLIC_PATH %>open-source.html"<% if (type === "开源字体") { %> aria-current="page"<% } %>>开源字体</a>
</nav>
<% if (typeof crumb !== "undefined" && crumb && crumb.current) { %>
<p class="breadcrumb">
  <a href="<%= PUBLIC_PATH %>index.html">首页</a><% if (crumb.href && crumb.label) { %> · <a href="<%= PUBLIC_PATH %><%= crumb.href %>"><%= crumb.label %></a><% } %> · <span><%= crumb.current %></span>
</p>
<% } %>
<p class="website-info">Free Font 收录了 <a href="https://github.com/jaywcjlove/free-font" target="_blank"><%= length %></a> 个可商用免费字体，方便《<a href="https://github.com/jaywcjlove/copybook-generator" target="_blank" title="字帖宝宝 for macOS">字帖宝宝</a>》用户下载和使用。</p>
