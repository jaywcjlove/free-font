<% const openSource = DATA.filter((item) => item.home && (item.home.includes("github.com") || item.home.includes("gitlab.com"))).sort((a, b) => b.ctime - a.ctime) %>
<%- include('./_partial/header', {
  type: "home",
  title: `免费开源字体下载（${openSource.length}款）｜Free Font`,
  pageurl: "open-source.html",
  ogImage: "icons/banner.jpeg",
  ogImageAlt: "Free Font 免费开源字体",
  description: `免费开源字体下载，共 ${openSource.length} 款来自 GitHub 与 GitLab 的可商用字体，支持个人与商业使用。`,
  keywords: "开源字体,免费开源字体,GitHub 字体,商用字体,字体下载,免费字体"
}); %>
<%- include('./_partial/header-title', { length: openSource.length, type: "开源字体", pageHeading: "免费开源字体", pageHeadingHref: PUBLIC_PATH + "open-source.html" }); %>
<main>
  <% openSource.forEach(function(font, idx){ %>
    <%- include('./_partial/home-list', { font, eager: idx === 0 }); %>
  <% }); %>
</main>
